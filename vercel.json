{
  "name": "foodies-app",
  "buildCommand": "cd zomato-clone && npm install && npm run build",
  "outputDirectory": "zomato-clone/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
